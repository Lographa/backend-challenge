PORT=3000
LOG_LEVEL=info

# PostgreSQL started by docker-compose.yml. These credentials are for local
# development only; never reuse them in any shared or production environment.
# POSTGRES_USER/PASSWORD/DB only apply when the Docker volume is first created;
# changing them later requires recreating the volume.
# Port 5433 avoids clashing with a locally installed PostgreSQL, which usually
# listens on 5432.
POSTGRES_USER=wagering_dev
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=wagering
POSTGRES_PORT=5433

# Three roles, see docs/database.md:
# - DATABASE_ADMIN_URL: the POSTGRES_USER superuser above. Used only by
#   `bun run db:provision` and by the integration test setup, never by the app.
# - MIGRATION_DATABASE_URL: owns the schema; used only by `bun run db:migrate*`.
# - DATABASE_URL: the application user (no superuser, no DELETE/TRUNCATE, ledger
#   SELECT/INSERT only). `bun run db:provision` creates both users from these URLs.
DATABASE_ADMIN_URL=postgresql://wagering_dev:local-dev-only@localhost:5433/wagering
MIGRATION_DATABASE_URL=postgresql://wagering_migrator:local-migrator-only@localhost:5433/wagering
DATABASE_URL=postgresql://wagering_app:local-app-only@localhost:5433/wagering
DATABASE_POOL_MAX=10

# Leave unset. `bun run db:migrate:down` refuses databases not ending in _test
# unless this names the target database exactly. A down migration drops tables,
# the financial ledger included, and is not a way to recover ledger data.
# MIGRATION_DOWN_CONFIRM_DATABASE=

# Leave unset. Integration tests only run against localhost unless this names
# the (non-local) database host explicitly.
# ALLOW_NON_LOCAL_TEST_DATABASE_HOST=

# LocalStack accepts any credentials; these values are fake and only meant for
# LocalStack. The AWS SDK reads them directly from the environment.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_INTEGRATION_EVENTS_QUEUE=wager-integration-events.fifo

HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
