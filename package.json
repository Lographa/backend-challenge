{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "db:provision": "bun run src/database/provision.ts",
    "db:migrate": "bun run src/database/migrate.ts up",
    "db:migrate:down": "bun run src/database/migrate.ts down",
    "db:migrate:status": "bun run src/database/migrate.ts status",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:destroy-volumes": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1177.0",
    "@mikro-orm/core": "^7.2.11",
    "@mikro-orm/migrations": "7.2.11",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.11",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
